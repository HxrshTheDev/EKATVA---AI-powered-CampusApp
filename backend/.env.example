# EKATVA BACKEND ENVIRONMENT CONFIGURATION

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ekatva

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production_12345
JWT_EXPIRY=7d

# Bcrypt
BCRYPT_ROUNDS=10

# API
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# AI Service Configuration
SAARTHI_API_KEY=your_gemini_api_key
SAARTHI_MODEL=gemini-pro

# Email (Optional for future)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_password

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Redis (Optional for caching)
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=your_session_secret_change_in_production
